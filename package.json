{
	"name": "synco-redux",
	"version": "1.2.5",
	"description": "A lightweight Redux enhancer for syncing state across different environments, including browser extensions and Electron applications",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git@github.com:justinasci/synco-redux.git"
	},
	"files": [
		"dist"
	],
	"main": "./dist/synco-redux.umd.cjs",
	"module": "./dist/synco-redux.js",
	"types": "./dist/main.d.ts",
	"exports": {
		"types": "./dist/main.d.ts",
		"import": "./dist/synco-redux.js",
		"require": "./dist/synco-redux.umd.cjs"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "oxlint --type-aware"
	},
	"devDependencies": {
		"@reduxjs/toolkit": "^2.6.0",
		"@types/electron": "^1.4.38",
		"@types/webextension-polyfill": "^0.12.3",
		"@typescript/typescript6": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.11",
		"electron": "^43.4.1",
		"oxlint": "^1.79.0",
		"oxlint-tsgolint": "^7.0.2001",
		"prettier": "^3.5.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-dts": "^5.0.3",
		"vite-plugin-oxlint": "^2.1.2",
		"vitest": "^4.1.11",
		"webextension-polyfill": "^0.12.0"
	},
	"peerDependencies": {
		"electron": ">=20.0.0",
		"immer": ">=10.0.0",
		"webextension-polyfill": ">=0.10.0"
	},
	"peerDependenciesMeta": {
		"webextension-polyfill": {
			"optional": true
		},
		"electron": {
			"optional": true
		}
	},
	"keywords": [
		"redux",
		"enchancer",
		"sync",
		"browser",
		"extension",
		"electron"
	]
}
